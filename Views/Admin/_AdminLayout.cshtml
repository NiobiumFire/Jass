@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<main>
    <div class="account-panel-container">
        <div class="parchment2 card tab-card admin-card">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Index">User Admin</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Maintenance">Maintenance</a>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                @RenderBody()
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @RenderSection("Scripts", required: false)
    <script>
        $(function () {
            const currentPage = location.pathname;
            $('.nav-tabs li a').each(function () {
                const $this = $(this);
                if (currentPage.toLowerCase().indexOf($this.attr('href').toLowerCase()) !== -1) {
                    $this.addClass('active');
                }
            })
        })
    </script>
}