@using Microsoft.AspNetCore.Identity;
@using BelotWebApp.Data;
@using BelotWebApp.Notification;
@inject ServerNotificationManager NotificationManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <link rel="manifest" href="~/manifest.json" asp-append-version="true">
    <meta name="theme-color" content="#000000">
    <link rel="shortcut icon" type="image/ico" href="~/images/NiobiumCrystal.ico">
    <title>@ViewData["Title"] - Nio Jass</title>
    @* CSS *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Assets.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BelotWebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css">
    @* Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rye&display=swap" rel="stylesheet" />
    @RenderSection("styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand navbar-dark box-shadow">
            <div class="container">
                <div class="d-flex justify-content-start align-items-center">
                    <ul class="navbar-nav d-flex align-items-center">
                        <li class="nav-item ms-1 me-3">
                            <a class="nav-link mx-0 px-1" href="@Url.Action("Index", "Home")">Main Menu</a>
                        </li>
                        @if (signInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link mx-0 px-1" href="@Url.Action("Index", "Admin")">Admin</a>
                            </li>
                        }
                    </ul>
                </div>
                <partial name="_LoginPartial.cshtml" />
            </div>
        </nav>
        @if (NotificationManager.NotificationIsActive)
        {
            <div id="maintenance-banner" class="notification"
                 data-scheduled-utc="@NotificationManager.Current.ScheduledUtc.ToString("o")"
                 data-message="@NotificationManager.Current.Message">
                @NotificationManager.Current.Message
            </div>
            @if (NotificationManager.Current.IsMaintenance)
            {
                <script>
                    (function () {
                        const banner = document.getElementById('maintenance-banner');
                        const scheduledUtc = new Date(banner.dataset.scheduledUtc); // "o" format parses as UTC
                        const baseMessage = banner.dataset.message;

                        function render() {
                            const now = new Date();
                            const diffMs = scheduledUtc - now;

                            if (diffMs <= 0) {
                                banner.textContent = baseMessage; // maintenance started or simple message
                                return;
                            }

                            const totalMinutes = Math.ceil(diffMs / 60000);
                            let timeText;
                            if (totalMinutes >= 60) {
                                const hours = Math.floor(totalMinutes / 60);
                                const mins = totalMinutes % 60;
                                timeText = mins > 0 ? `${hours}h ${mins}m` : `${hours}h`;
                            } else {
                                timeText = `${totalMinutes} min`;
                            }

                            banner.textContent = `Server maintenance begins in ${timeText}`;
                        }

                        render();
                        setInterval(render, 30000);
                    })();
                </script>
            }
        }
    </header>
    <canvas class="nebula" id="nebula"></canvas>
    @RenderBody()

    <footer>
        <div class="container">
            &copy; 2026 - NiobiumFire - <a style="color:white" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js');
        }

        document.addEventListener('touchstart', function () { }, { passive: true }); // allow safari ios to register button active state
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Nebula.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
