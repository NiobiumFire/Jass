@model BelotRoomCreationOptions

<div class="modal create-game-modal" tabindex="-1" id="create-game-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content parchment2">
            <form asp-controller="Room" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Create casual room</h5>
                    <i class="bi bi-x-lg form-btn" data-bs-dismiss="modal"></i>
                </div>

                <div class="modal-body">

                    <div class="game-options-container">
                        <div class="form-floating mb-2 w-100">
                            <input asp-for="RoomName" class="form-control" spellcheck="false" />
                            <label asp-for="RoomName" class="form-label"></label>
                        </div>

                        <div class="setting-container form-control">
                            <label class="setting-label form-label">Score target<i class="bi bi-caret-right-fill ms-2"></i><i class="bi bi-caret-left-fill"></i></label>

                            <div class="btn-group w-100 d-flex justify-content-center" role="group">
                                <input class="btn-check" type="radio" asp-for="ScoreTarget" id="score501" value="501" />
                                <label class="btn2" for="score501">501</label>

                                <input class="btn-check" type="radio" asp-for="ScoreTarget" id="score1001" value="1001" />
                                <label class="btn2" for="score1001">1001</label>

                                <input class="btn-check" type="radio" asp-for="ScoreTarget" id="score1501" value="1501" />
                                <label class="btn2" for="score1501">1501</label>
                            </div>
                        </div>

                        <div class="setting-container form-control">
                            <label class="setting-label form-label">Turn time<i class="bi bi-alarm ms-2"></i></label>

                            <div class="btn-group w-100 d-flex justify-content-center" role="group">
                                <input class="btn-check" type="radio" asp-for="TurnTime" id="time10" value="10" />
                                <label class="btn2" for="time10">10s</label>

                                <input class="btn-check" type="radio" asp-for="TurnTime" id="time30" value="30" />
                                <label class="btn2" for="time30">30s</label>

                                <input class="btn-check" type="radio" asp-for="TurnTime" id="time60" value="60" />
                                <label class="btn2" for="time60">60s</label>

                                <input class="btn-check" type="radio" asp-for="TurnTime" id="time120" value="120" />
                                <label class="btn2" for="time120">120s</label>

                                <input class="btn-check" type="radio" asp-for="TurnTime" id="time0" value="0" />
                                <label class="btn2" for="time0">∞</label>
                            </div>
                        </div>

                        <div class="setting-container form-control mb-0">
                            <label class="setting-label form-label">Allow chat<i class="bi bi-envelope-fill ms-2"></i></label>

                            <div class="btn-group w-100 d-flex justify-content-center" role="group">
                                <input class="btn-check" type="radio" asp-for="AllowChat" id="chat-enabled" value="true" />
                                <label class="btn2" for="chat-enabled">Yes</label>

                                <input class="btn-check" type="radio" asp-for="AllowChat" id="chat-disabled" value="false" />
                                <label class="btn2" for="chat-disabled">No</label>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn2">
                        Create Room
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>